# 19-final/config/ecommerce.env
# The SHARED configuration, as KEY=VALUE lines. Kustomize turns this into
# ConfigMap/ecommerce-config-<hash>: immutable, named by its content.
# Change one value -> new name -> every referencing pod template changes ->
# a real rollout, with a revision `kubectl rollout undo` can return to.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=ecommerce
REDIS_HOST=redis
REDIS_PORT=6379
CATALOG_URL=http://catalog:8080
CART_URL=http://cart:8080
ORDER_URL=http://order:8080
PAYMENT_URL=http://payment:8080
UPSTREAM_TIMEOUT_SECONDS=3
CART_TTL_SECONDS=1800
PAYMENT_LATENCY_MS=0
PAYMENT_FAIL_RATE=0
